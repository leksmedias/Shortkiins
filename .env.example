# TTS API Credentials
# Primary: Inworld AI TTS (Default - with word timestamps)
# Get your base64 credential from: https://studio.inworld.ai/
INWORLD_API_KEY=your_base64_credential_here

# Alternative: AsyncFlow TTS (backup option)
ASYNCFLOW_API_KEY=your_asyncflow_api_key_here

# Groq API (for scene division)
GROQ_API_KEY=your_groq_api_key_here

# Image Generation APIs
# Freepik API
FREEPIK_API_KEY=your_freepik_api_key_here

# Wave Speed AI
WAVESPEED_API_KEY=your_wavespeed_api_key_here

# Replicate (alternative image generation)
REPLICATE_API_TOKEN=your_replicate_token_here

# Output Settings
OUTPUT_DIR=output
TEMP_DIR=temp
SCENE_DURATION=3  # Duration in seconds for each scene

# Video Settings
ASPECT_RATIO=16:9  # Options: "16:9" (landscape 1280x720) or "9:16" (portrait 720x1280)
VIDEO_FPS=24
